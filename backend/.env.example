PORT=4000

# MongoDB Atlas connection string
# Локально: пароль без кутових дужок < >, вони лише позначка-приклад
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elias?retryWrites=true&w=majority

# JWT
# Продакшн: згенеруй справжні значення командою в терміналі:
#   openssl rand -hex 32
# Ніколи не використовуй значення нижче на реальному сайті.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS: адреса фронтенду
# Локально: http://localhost:5173
# Продакшн: https://твій-домен.vercel.app (без / в кінці)
CLIENT_ORIGIN=http://localhost:5173

# Постав NODE_ENV=production на хостингу (Render/Railway) —
# без цього refresh-cookie піде без прапорця secure
NODE_ENV=development
